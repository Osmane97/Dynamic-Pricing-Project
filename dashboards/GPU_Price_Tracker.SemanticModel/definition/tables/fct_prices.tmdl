table fct_prices
	lineageTag: 284235a1-7f27-4538-b1bf-7b86aff16dbb

	measure 'Avg Price' = AVERAGE(fct_prices[actual_price])
		lineageTag: 45275dc9-aa5c-4e37-bc7b-2d047dd1614f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Lowest Price' = MIN(fct_prices[actual_price])
		lineageTag: bd3fa313-2789-4465-ac7a-0c6b4cbbdc28

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest Price' = ```
			
			VAR last_scrape = MAX(fct_prices[scrape_time])
			RETURN
			    CALCULATE(AVERAGE(fct_prices[actual_price]), fct_prices[scrape_time] = last_scrape)
			
			```
		lineageTag: b81fd4a8-69cc-48ac-bce0-25cd469e88a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Products Tracked' = DISTINCTCOUNT(fct_prices[asin])
		formatString: 0
		lineageTag: b6d95f51-ae20-42f7-ab4e-d251fa5e3420

	measure 'Last Updated' = MAX(fct_prices[scrape_time])
		formatString: dd mmm yyyy hh:nn
		lineageTag: 912a1f3d-9adb-475d-aac3-8cd6202868d6

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Avg Current Price' = AVERAGEX(VALUES(fct_prices[asin]), [Latest Price])
		formatString: #,0
		lineageTag: d1c3355e-07a7-4680-8351-0d6825a50944

	measure 'Price Drops' =
			COUNTROWS(
			    FILTER(
			        VALUES(fct_prices[asin]),
			        [Latest Price] < 0.99 * CALCULATE(MAX(fct_prices[actual_price]))
			    )
			) + 0
		formatString: 0
		lineageTag: 80056645-3f03-4f25-b1f0-4de10380bbb9

	measure Price =
			VAR p = [Avg Price]
			RETURN IF(p <= 5000, p)
		formatString: #,0.00
		lineageTag: 87ac2912-5260-4199-a391-60c185da40ee

